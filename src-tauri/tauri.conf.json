{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ADB Manager",
  "version": "1.1.21",
  "identifier": "com.burpeepoo.adb-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ADB Manager",
        "width": 1440,
        "height": 820,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "transparent": false,
        "backgroundColor": "#ffffffff"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/platform-tools",
      "resources/scrcpy"
    ],
    "macOS": {
      "dmg": {
        "background": null
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5Rjg0QjAyNTM4MDQxRgpSV1FmQkRnbHNJU2ZBcGZCL2s2amNpc1VxYnI2QXUzK1g2bXV4MkpBNEJydG1BMFVXWWY3elNUSQo=",
      "endpoints": [
        "https://github.com/burpeepoo/adb-devices/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
