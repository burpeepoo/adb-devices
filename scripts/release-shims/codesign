#!/bin/bash
set -euo pipefail

real_codesign="/usr/bin/codesign"

if [[ -z "${APPLE_CODESIGN_TIMESTAMP_URL:-}" ]]; then
    exec "$real_codesign" "$@"
fi

args=()
for arg in "$@"; do
    if [[ "$arg" == "--timestamp" || "$arg" == --timestamp=* ]]; then
        args+=("--timestamp=$APPLE_CODESIGN_TIMESTAMP_URL")
    else
        args+=("$arg")
    fi
done

exec "$real_codesign" "${args[@]}"
