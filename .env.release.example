# Copy this to .env.release and fill in local values. Do not commit .env.release.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_INSTALLER_SIGNING_IDENTITY="Developer ID Installer: Your Name (TEAMID)"
APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
APPLE_API_KEY="XXXXXXXXXX"
APPLE_API_KEY_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"

# Tauri updater signing. Keep this key outside the repository.
TAURI_SIGNING_PRIVATE_KEY="/Users/you/.tauri/adb-manager-updater.key"
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
