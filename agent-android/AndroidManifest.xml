<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cozyla.adbmanager.agent">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:allowBackup="false"
        android:label="ADB Manager Agent"
        android:theme="@android:style/Theme.NoDisplay">
        <activity
            android:name=".AgentBootstrapActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".AgentAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_service" />
        </service>
    </application>
</manifest>
